# Keep the build context small and free of secrets.
.git/
.gitignore
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Never bake secrets or engagement data into the image.
.env
venom_data/
engagements/

# Dev-only files not needed at runtime.
tests/
.claude/
*.md
!README.md
