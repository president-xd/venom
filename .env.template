# VENOM (CIPHER runtime) — Environment Variables Template
# Copy to .env and fill in your values before running:  cp .env.template .env

# =============================================================================
# LLM PROVIDER KEYS
# =============================================================================

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter — https://openrouter.ai/keys
# Gives access to 200+ models with a single key and automatic fallback
OPENROUTER_API_KEY=sk-or-...

# NVIDIA NIM — https://build.nvidia.com
# For enterprise GPU-accelerated inference or self-hosted NIM containers
NVIDIA_API_KEY=nvapi-...
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
# If self-hosted: NVIDIA_NIM_BASE_URL=http://your-nim-host:8000/v1/chat/completions

# Ollama — local, no key needed
# Install: https://ollama.ai — then: ollama pull llama3.1:70b
OLLAMA_BASE_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.1:70b

# =============================================================================
# MULTI-AGENT MODEL SELECTION  <-- this is where you pick models
# =============================================================================
# VENOM runs a fleet of agents, each backed by the model best suited to its
# job, all served through the single NVIDIA NIM key above. The base model is
# DeepSeek. Override any role here; see `VENOM agents` for the live mapping.

VENOM_MULTI_AGENT=true
VENOM_BASE_MODEL=deepseek-ai/deepseek-v4-pro

# Orchestrator (main) + Reporter  -> DeepSeek (base, strongest reasoning)
VENOM_MODEL_ORCHESTRATOR=deepseek-ai/deepseek-v4-pro
VENOM_MODEL_REPORTER=deepseek-ai/deepseek-v4-pro
# Research agent                  -> GLM
VENOM_MODEL_RESEARCH=z-ai/glm-5.1
# Hypothesis subagent             -> Kimi
VENOM_MODEL_HYPOTHESIS=moonshotai/kimi-k2.6
# CodeGen + Summarizer subagents  -> Qwen (large MoE)
VENOM_MODEL_CODEGEN=qwen/qwen3.5-397b-a17b
VENOM_MODEL_SUMMARIZER=qwen/qwen3.5-397b-a17b

# --- NVIDIA NIM model catalog (alias=full-model-id) --------------------------
# Register/override the models available to VENOM WITHOUT editing any code.
# Comma-separated `alias=full/model-id` pairs. Aliases (left side) can be used
# as shorthand above, e.g.  VENOM_MODEL_HYPOTHESIS=kimi-k2.6
# Add a new model by appending another `alias=org/model` pair to this line.
VENOM_NVIDIA_MODELS=deepseek-v4-pro=deepseek-ai/deepseek-v4-pro,kimi-k2.6=moonshotai/kimi-k2.6,glm-5.1=z-ai/glm-5.1,qwen3.5=qwen/qwen3.5-397b-a17b,llama3.1-70b=meta/llama-3.1-70b-instruct,llama3.1-405b=meta/llama-3.1-405b-instruct,nemotron-340b=nvidia/nemotron-4-340b-instruct

# =============================================================================
# LLM ROUTING MODE
# =============================================================================

# Options: "default" | "budget" | "air_gap"
# default  -> Anthropic for reasoning, OpenRouter for cost-sensitive tasks, Ollama for embeddings
# budget   -> OpenRouter for everything except most critical tasks
# air_gap  -> Ollama only, nothing leaves the network
LLM_MODE=default

# Force all traffic to Ollama regardless of LLM_MODE setting
LLM_AIR_GAP=false

# If no provider keys are present, VENOM runs in OFFLINE mode: deterministic
# playbook-based test generation only (no LLM hypotheses). Set to "true" to
# require an LLM and fail fast if none is configured.
VENOM_REQUIRE_LLM=false

# =============================================================================
# BURP SUITE MCP INTEGRATION  (KEYLESS — runs locally, no API key)
# =============================================================================
# The PortSwigger "MCP Server" extension runs inside Burp on your machine and
# exposes a loopback SSE endpoint. There is NO API key. Provision it once with:
#
#   pwsh scripts/setup_burp.ps1       # download Burp + MCP extension
#   pwsh scripts/run_burp_mcp.ps1     # launch Burp with the extension loaded
#
# (bash equivalents: scripts/setup_burp.sh / scripts/run_burp_mcp.sh)

BURP_MCP_ENABLED=false
BURP_MCP_URL=http://127.0.0.1:9876/sse

# Where setup scripts install Burp + the MCP extension jar.
VENOM_TOOLS_DIR=./tools

# =============================================================================
# AGENT OPERATIONAL SETTINGS
# =============================================================================

# Default rate limit for HTTP test requests (requests per second).
# Override per-engagement in the scope object (scope value always wins).
DEFAULT_RATE_LIMIT_RPS=5

# Whether to allow destructive test operations by default.
# Per-engagement override in scope object always takes precedence.
DEFAULT_ALLOW_DESTRUCTIVE=false

# =============================================================================
# WEB-APP MODE (HTML/form/cookie sites — not just JSON APIs)
# =============================================================================
# VENOM handles classic web apps as well as JSON APIs. These capabilities are
# driven by the SCOPE object, not env, but here's what to set there:
#
#   "discovery": {"enabled": true, "seeds": ["/"], "max_pages": 60,
#                 "forced_browse": true}   <- crawl the target; no artifacts needed
#   identities[].auth.type = "form_login"  <- HTML login (CSRF scrape + cookie)
#   "allow_pii_capture": false             <- keep PII redacted in evidence/logs
#
# Run point-and-shoot discovery from the CLI:
#   VENOM run --scope scope.json --crawl --live      (no --in needed)
#
# A bundled forced-browse wordlist ships at VENOM/data/wordlists/common.txt
# (override by editing it; it is packaged into the Docker image).

# Directory for storing engagement artifacts, RAG corpus, and reports
VENOM_DATA_DIR=./venom_data

# FAISS index path for pentest writeup corpus (optional RAG)
RAG_INDEX_PATH=./venom_data/rag/pentest_writeups.faiss

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# =============================================================================
